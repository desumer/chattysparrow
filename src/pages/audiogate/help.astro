---
import AppsLayout from "@layouts/AppsLayout.astro";
import Header from "@components/audiogate/Header.astro";
import Footer from "@components/Footer.astro";
import { withBase } from '@utils/paths';
---

<AppsLayout title="Audio Gate - User Guide" faviconPath={withBase("/favicons/audiogate")}>

  <style>
.shell{--ink:#18324a;--blue:#087ff5;--teal:#19b7b0;--muted:#5f6b76;--paper:#fff;--line:#dbe3ea;--soft:#edf5fc;--warn:#fff4e5;--danger:#fdecec;--shadow:0 16px 42px rgba(25,48,69,.12)}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:1.5rem}body{margin:0;background:#eef2f5;color:#1f2933;font:16px/1.58 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}a{color:var(--blue)}
.shell{display:grid;grid-template-columns:290px minmax(0,920px);justify-content:center;gap:28px;width:100%;max-width:none;margin:0;padding:28px}.index{position:sticky;top:24px;align-self:start;background:var(--ink);color:#fff;border-radius:16px;padding:22px;max-height:calc(100vh - 48px);overflow:auto}.index h1{font-size:1.28rem;margin:0 0 4px}.index .platform{color:#76ded7;font-weight:750;font-size:.82rem;text-transform:uppercase;letter-spacing:.07em}.index p{color:#c9d6df;font-size:.88rem;margin:.5rem 0 1rem}.index nav{display:grid;gap:5px}.index a{display:grid;grid-template-columns:29px 1fr;gap:8px;align-items:start;color:#edf6ff;text-decoration:none;padding:9px;border-radius:9px;font-size:.87rem}.index a:hover,.index a:focus{background:#294d69;outline:none}.index a span{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:var(--blue);font-weight:750}.index .email{display:block;margin-top:14px;color:#b9e7ff;font-size:.85rem}
.shell > main{display:grid;gap:28px}.guide-page{scroll-margin-top:24px;color:#1f2933;background:var(--paper);min-height:calc(100vh - 56px);padding:58px 64px;border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow);position:relative;overflow:visible}.page-label{position:absolute;top:20px;right:28px;color:var(--muted);font-size:.76rem;font-weight:750;text-transform:uppercase;letter-spacing:.08em}.guide-page>h1:first-of-type{font-size:2.5rem}.help-guide-cover{display:block;text-align:center;padding-top:5vh}.help-guide-cover .kicker{color:var(--teal);font-weight:800;letter-spacing:.07em;text-transform:uppercase}.help-guide-cover h1{font-size:3rem;line-height:1.06;color:var(--ink);margin:.2em 0}.help-guide-cover .lead{font-size:1.15rem;color:var(--muted);max-width:720px;margin:1.4rem auto}.topic-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:2rem}.topic-grid a{border:1px solid var(--line);border-radius:9px;padding:12px;text-decoration:none;color:var(--ink);display:grid}.topic-grid a:hover{border-color:var(--blue);background:#f7fbff}.topic-grid small{color:var(--muted)}
h1{font-size:2.6rem;line-height:1.08;color:var(--ink);margin:.25em 0 .6em}h2,h3{font-size:1.65rem;line-height:1.2;color:var(--blue);margin:0 0 .8rem}h4{color:var(--ink)}p{margin:.6em 0}ul,ol{padding-left:1.45rem}li{padding:.15rem 0}.guide-page p>strong:first-child,.guide-page .fw-bold{color:var(--ink)}.guide-page img{display:block;max-width:100%;height:auto!important;margin:1.4rem auto;border-radius:9px;box-shadow:0 10px 24px rgba(0,0,0,.14)}.guide-page p:has(>img){margin:0}.callout{padding:14px 16px;border-radius:8px;background:var(--soft);border-left:4px solid var(--blue);margin:1.1rem 0}.callout.warning{background:var(--warn);border-color:#ff9500}.callout.danger{background:var(--danger);border-color:#b42318}.back{display:inline-block;margin-top:1.5rem;font-size:.82rem;color:var(--muted)}code{background:#f1f4f6;border-radius:4px;padding:.1em .35em}.sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:920px){.shell{display:block;padding:12px}.index{position:relative;top:auto;max-height:none;margin-bottom:16px}.index nav{grid-template-columns:1fr 1fr}.guide-page{min-height:0;padding:50px 28px}}
@media(max-width:580px){.index nav,.topic-grid{grid-template-columns:1fr}.guide-page{padding:48px 18px}.help-guide-cover h1{font-size:2.35rem}h1{font-size:2.1rem}}
@media print{body{background:#fff}.shell{display:block;max-width:none;padding:0}.index{display:none}.shell > main{display:block}.guide-page{box-shadow:none;border:0;border-radius:0;min-height:auto;break-after:page;padding:.6in}.guide-page:last-child{break-after:auto}.back{display:none}}
</style>

