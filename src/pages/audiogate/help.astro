    <main>
      <section class="guide-page help-guide-cover" id="overview" data-page="1" aria-labelledby="overview-label">
        <div class="page-label" id="overview-label">Section 1 of 12</div>
        <p class="kicker">Product help / macOS</p>
        <h1>Audio Gate Recorder</h1>
        <p class="lead">Thank you for choosing Audio Gate Recorder! We’re excited to help you bring your audio together. Capture and mix application sources, microphones, and audio interfaces in a flexible recording workspace designed to make your recording workflow simple and intuitive.</p>
        <nav class="topic-grid" aria-label="Topic index">
