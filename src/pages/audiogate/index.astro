---
import AppsLayout from "@layouts/AppsLayout.astro";
import Header from "@components/audiogate/Header.astro";
import Hero from "@components/audiogate/Hero.astro";
import Portfolio from "@components/audiogate/Portfolio.astro";
import Features from "@components/audiogate/Features.astro";
import Contact from "@components/Contact.astro";
import Footer from "@components/Footer.astro";
import About from "@components/audiogate/About.astro";
import { withBase } from '@utils/paths';
---

<AppsLayout title="Audio Gate - Audio Recording app for macOS" faviconPath={withBase("/favicons/audiogate")} description="Audio Gate is a simple audio recording application for macOS that allows you to record audio from any input device, including microphones, line-in, and system audio. It also allows you to record audio from any application that supports audio output.">

<Header />

<main>

    <Hero />

    <Portfolio />

    <Features />

    <Contact  sectionColor="light-background" />

    <About />
    
</main>

<Footer />

<script>
document.getElementById("email-link")?.addEventListener("click",(e)=>{
    e.preventDefault();

    const user="support";
    const domain="chattysparrow.com";

    window.location.href=`mailto:${user}@${domain}`;
});
</script>

</AppsLayout>