---
import AppsLayout from "@layouts/AppsLayout.astro";
import Header from "@components/audiogate/Header.astro";
import Footer from "@components/Footer.astro";
import { withBase } from '@utils/paths';
---

<AppsLayout title="Chatty Sparrow - End User License Agreement" faviconPath={withBase("/favicons/audiogate")} description="This End-User License Agreement (EULA) is a legal agreement between you (either as an individual or on behalf of an entity) and Davut Sumer (The AUTHOR) regarding your use of ChattySparrow's desktop applications (Audio Gate), and associated documentation (the 'Software'). IF YOU DO NOT AGREE TO ALL OF THE TERMS OF THIS EULA, DO NOT INSTALL, USE OR COPY THE SOFTWARE.">

<Header />

<main>

    <section id="eula" class="features section">
      <div class="container" data-aos="fade-up" data-aos-delay="100">
        <!-- Content -->
        <h1>End User License Agreement (EULA)</h1>
        <p class=""><span class=""><br/></span></p>
        <p class=""><a name="user-content-end-user-license-agreement"></a><span class="">This End-User License Agreement (EULA) is a legal agreement between you (either as an individual or on behalf of an entity) and Davut Sumer (The AUTHOR) regarding your use of ChattySparrow's desktop applications (Audio Gate), and associated documentation (the "Software"). IF YOU DO NOT AGREE TO ALL OF THE TERMS OF THIS EULA, DO NOT INSTALL, USE OR COPY THE SOFTWARE.</span></p>
        <p class=""><a href="https://www.apple.com/legal/internet-services/itunes/dev/stdeula">Licensed Application End User License Agreement</a></p>
    </div>
    </section>

</main>

<Footer />

<script>
document.getElementById("email-link")?.addEventListener("click",(e)=>{
    e.preventDefault();

    const user="support";
    const domain="chattysparrow.com";

    window.location.href=`mailto:${user}@${domain}`;
});
</script>

</AppsLayout>