---
import AppsLayout from "@layouts/AppsLayout.astro";
import Header from "@components/vudeck/Header.astro";
import Footer from "@components/Footer.astro";
import { withBase } from '@utils/paths';
---

<AppsLayout title="VU Deck - Windows Help" faviconPath={withBase("/favicons/vudeck")} description="VU Deck is a Windows application that displays the level of your selected audio using analog meters, with an optional LED meter and audio spectrum analyzer. Capture selected apps and microphones through System Audio, or monitor an installed virtual audio device.">
  
<style>
.shell{--ink:#18324a;--blue:#087ff5;--teal:#19b7b0;--muted:#5f6b76;--paper:#fff;--line:#dbe3ea;--soft:#edf5fc;--warn:#fff4e5;--danger:#fdecec;--shadow:0 16px 42px rgba(25,48,69,.12)}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:1.5rem}body{margin:0;background:#eef2f5;color:#1f2933;font:16px/1.58 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}a{color:var(--blue)}
.shell{display:grid;grid-template-columns:290px minmax(0,920px);justify-content:center;gap:28px;width:100%;max-width:none;margin:0;padding:28px}.index{position:sticky;top:24px;align-self:start;background:var(--ink);color:#fff;border-radius:16px;padding:22px;max-height:calc(100vh - 48px);overflow:auto}.index h1{font-size:1.28rem;margin:0 0 4px}.index .platform{color:#76ded7;font-weight:750;font-size:.82rem;text-transform:uppercase;letter-spacing:.07em}.index p{color:#c9d6df;font-size:.88rem;margin:.5rem 0 1rem}.index nav{display:grid;gap:5px}.index a{display:grid;grid-template-columns:29px 1fr;gap:8px;align-items:start;color:#edf6ff;text-decoration:none;padding:9px;border-radius:9px;font-size:.87rem}.index a:hover,.index a:focus{background:#294d69;outline:none}.index a span{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:var(--blue);font-weight:750}.index .email{display:block;margin-top:14px;color:#b9e7ff;font-size:.85rem}
.shell > main{display:grid;gap:28px}.guide-page{scroll-margin-top:24px;color:#1f2933;background:var(--paper);min-height:calc(100vh - 56px);padding:58px 64px;border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow);position:relative;overflow:visible}.page-label{position:absolute;top:20px;right:28px;color:var(--muted);font-size:.76rem;font-weight:750;text-transform:uppercase;letter-spacing:.08em}.guide-page>h1:first-of-type{font-size:2.5rem}.help-guide-cover{display:block;text-align:center;padding-top:5vh}.help-guide-cover .kicker{color:var(--teal);font-weight:800;letter-spacing:.07em;text-transform:uppercase}.help-guide-cover h1{font-size:3rem;line-height:1.06;color:var(--ink);margin:.2em 0}.help-guide-cover .lead{font-size:1.15rem;color:var(--muted);max-width:720px;margin:1.4rem auto}.topic-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:2rem}.topic-grid a{border:1px solid var(--line);border-radius:9px;padding:12px;text-decoration:none;color:var(--ink);display:grid}.topic-grid a:hover{border-color:var(--blue);background:#f7fbff}.topic-grid small{color:var(--muted)}
h1{font-size:2.6rem;line-height:1.08;color:var(--ink);margin:.25em 0 .6em}h2,h3{font-size:1.65rem;line-height:1.2;color:var(--blue);margin:0 0 .8rem}h4{color:var(--ink)}p{margin:.6em 0}ul,ol{padding-left:1.45rem}li{padding:.15rem 0}.guide-page p>strong:first-child,.guide-page .fw-bold{color:var(--ink)}.guide-page img{display:block;max-width:100%;height:auto!important;margin:1.4rem auto;border-radius:9px;box-shadow:0 10px 24px rgba(0,0,0,.14)}.guide-page p:has(>img){margin:0}.callout{padding:14px 16px;border-radius:8px;background:var(--soft);border-left:4px solid var(--blue);margin:1.1rem 0}.callout.warning{background:var(--warn);border-color:#ff9500}.callout.danger{background:var(--danger);border-color:#b42318}.back{display:inline-block;margin-top:1.5rem;font-size:.82rem;color:var(--muted)}code{background:#f1f4f6;border-radius:4px;padding:.1em .35em}.sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:920px){.shell{display:block;padding:12px}.index{position:relative;top:auto;max-height:none;margin-bottom:16px}.index nav{grid-template-columns:1fr 1fr}.guide-page{min-height:0;padding:50px 28px}}
@media(max-width:580px){.index nav,.topic-grid{grid-template-columns:1fr}.guide-page{padding:48px 18px}.help-guide-cover h1{font-size:2.35rem}h1{font-size:2.1rem}}
@media print{body{background:#fff}.shell{display:block;max-width:none;padding:0}.index{display:none}.shell > main{display:block}.guide-page{box-shadow:none;border:0;border-radius:0;min-height:auto;break-after:page;padding:.6in}.guide-page:last-child{break-after:auto}.back{display:none}}
</style>

<Header />

<div class="shell" id="top">
    <aside class="index">
      <div class="platform">Windows help</div>
      <h1>VU Deck</h1>
      <p>Jump to any topic...</p>
      <nav aria-label="Section index">
        <a href="#overview"><span>1</span>Overview</a>
        <a href="#getting-started"><span>2</span>Getting Started</a>
        <a href="#system-requirements"><span>3</span>System Requirements</a>
        <a href="#installation-guide"><span>4</span>Installation Guide</a>
        <a href="#first-run"><span>5</span>First Run</a>
        <a href="#general-settings"><span>6</span>General Settings</a>
        <a href="#audio-settings"><span>7</span>Audio Settings</a>
        <a href="#troubleshooting"><span>8</span>Troubleshooting</a>
        <a href="#feedback-and-support"><span>9</span>Feedback and Support</a>
      </nav>
      <a class="email" href="#" id="email-link">Contact support</a>
    </aside>
    <main>
      <section class="guide-page help-guide-cover" id="overview" data-page="1" aria-labelledby="overview-label">
        <div class="page-label" id="overview-label">Section 1 of 9</div>
        <p class="kicker">Product help / Windows</p>
        <h1>VU Deck</h1>
        <p class="lead">Install and configure VU Deck, select the correct Windows audio device, customize its meters.</p>
        <nav class="topic-grid" aria-label="Topic index">
          <a href="#getting-started">
            <b>Getting Started</b>
            <small>Open section 2</small>
          </a>
          <a href="#system-requirements">
            <b>System Requirements</b>
            <small>Open section 3</small>
          </a>
          <a href="#installation-guide">
            <b>Installation Guide</b>
            <small>Open section 4</small>
          </a>
          <a href="#first-run">
            <b>First Run</b>
            <small>Open section 5</small>
          </a>
          <a href="#general-settings">
            <b>General Settings</b>
            <small>Open section 6</small>
          </a>
          <a href="#audio-settings">
            <b>Audio Settings</b>
            <small>Open section 7</small>
          </a>
          <a href="#troubleshooting">
            <b>Troubleshooting</b>
            <small>Open section 8</small>
          </a>
          <a href="#feedback-and-support">
            <b>Feedback and Support</b>
            <small>Open section 9</small>
          </a>
        </nav>
      </section>

      <section class="guide-page" id="getting-started" data-page="2" aria-labelledby="getting-started-label">
        <div class="page-label" id="getting-started-label">Section 2 of 9</div>

        <!-- Content -->
        <h2>Getting Started</h2>
        <p><span>Thank you for choosing VU Deck and making VU Deck part of your music listening experience.</span></p>
        <p><span>VU Deck is a standalone entertainment app for music lovers. You can customize the look and feel of the app to suit your preferences. Choose between an Analog VU meter and a Spectrum display, and you can even add an LED VU Meter to the Spectrum display.</span><span></span></p>
        <p><span>I will always listen to your recommendations and make necessary updates. </span></p>
        <p><span>Thank you for your support. </span></p>
    <a class="back" href="#top">Back to index ↑</a></section><section class="guide-page" id="system-requirements" data-page="3" aria-labelledby="system-requirements-label"><div class="page-label" id="system-requirements-label">Section 3 of 9</div>
        <!-- Content -->
        <h2>System Requirements</h2>
        <p><span>To be able to use VU Deck, your Windows system needs following requirements:</span></p>
        <ul>
        <li>Windows 10 version 17763.0 or later.</li>
        <li>Minimum 2 GB of memory recommended.</li>
        <li>Supports Windows WASAPI loopback capture.</li>
        <li>ASIO drivers are not supported.</li>
        <li>Compatible with x86, x64, and ARM64 processors.</li>
        <li>Graphics card is recommended.</li>
        </ul>
    <a class="back" href="#top">Back to index ↑</a></section><section class="guide-page" id="installation-guide" data-page="4" aria-labelledby="installation-guide-label"><div class="page-label" id="installation-guide-label">Section 4 of 9</div>
        <!-- Content -->
        <h2>Installation Guide</h2>
        <p><span>Installation process is one click automatic install via Microsoft app store.</span></p>
        <p><span>If you have previously installed VU Deck and there is an update follow the screens to update VU Deck if you wish to do so. </span></p>
      <a class="back" href="#top">Back to index ↑</a></section><section class="guide-page" id="first-run" data-page="5" aria-labelledby="first-run-label"><div class="page-label" id="first-run-label">Section 5 of 9</div>
        <!-- Content -->
        <h2>First Run</h2>
        <p><span>Windows sound settings determine how the audio will be set when VU Deck runs for the first time.</span></p>
        <p><span>When application runs for the first time automatically selects your system's default output audio device to use.</span></p>
        <p><span>Application looks for any available virtual loop-back audio device driver. If you have multiple loop-back device drivers installed in your system, you can select the device driver you wish to use from "Select Device" drop down list in Setup.</span></p>
        <p><img alt="windowssetup interface screenshot" src="data:image/png;base64,"></p>
        <p><span>If you install new  loop-back audio device driver to your system later on, you can use "Load" button next to "Select Device" drop down and refresh the list of available  loop-back audio device drivers then select the newly loaded device driver from  "Select Device" drop down.</span></p>
        <p><span>Resizing and Dragging The App Window:</span></p>
        <p><span>The application window can be resized proportionally. To resize the window, move your mouse to the left or right edge of the window. When the mouse pointer changes, click and hold the left mouse button, then drag to resize.</span></p>
        <p><span>The application window cannot be resized smaller than a certain size to ensure that all elements within the window remain visible.</span></p>
        <p><span>The application window can be moved on the screen by clicking and holding the left mouse button on an empty spot, then dragging it to the desired location.</span></p>
      <a class="back" href="#top">Back to index ↑</a></section><section class="guide-page" id="general-settings" data-page="6" aria-labelledby="general-settings-label"><div class="page-label" id="general-settings-label">Section 6 of 9</div>
        <!-- Content -->
        <h2>General Settings</h2>
        <p><span>You can customize the application according to your preferences.</span></p>
        <p><img alt="windowssetup 1 interface screenshot" src="data:image/png;base64,"></p>
        <p><span>Meter Style</span><span>: Is default to "Peak" for analog VU Meter.</span></p>
        <p><span>Meter Adjustment(-)</span><span>: Can be set between 0 and 36. You can adjust to movement of analog needle based on your systems volume settings.</span></p>
        <p><span>VU Background</span><span>: Background of Analog VU Meter can be set as, Blue, Yellow, Gray.</span></p>
        <p><span>Spectrum Colors</span><span>:  Spectrum bar colors can be set as, Rainbow, Classic, Green, Blue and White.</span></p>
        <p><span>Display LED VU</span><span>: When selected, LED Peak VU Meter displays under Spectrum window.</span></p>
        <p><span>Keep On Top</span><span>: When selected, for your convenience VU Deck app window stays on top of every other running application.   </span></p>
        <p><span>Default Window</span><span>: When selected, window of the application displays as default system window.</span></p>
        <p><span>Hide Logo</span><span>: When selected, VU Deck logo will not be displayed on the main panel.</span></p>
        <p><span>Face Panel Color</span><span>: You can select, color of the face panel.</span></p>
        <br>
        <p><span>Clicking on "OK" button makes your selections permanent. If you click "Cancel" button any selections you did will be lost.</span></p>
      <a class="back" href="#top">Back to index ↑</a></section><section class="guide-page" id="audio-settings" data-page="7" aria-labelledby="audio-settings-label"><div class="page-label" id="audio-settings-label">Section 7 of 9</div>
        <!-- Content -->
        <h2>Audio Settings</h2>
        <p><span>VU Deck supports only Virtual Audio Loopback Devices.</span></p>
        <p><span>Whenever you make changes to the audio settings on your system's sound settings, you also need to update the VU Deck audio settings accordingly; otherwise, your application may stop working.</span></p>
        <p><span>The active playback/output device in Windows sound settings must be the same as the device you selected in the VU Deck setup window.</span></p>
        <p><span>You can always go to the setup and make any necessary changes.</span></p>
        <p><span>If you install a new audio device to your system, go to VU Deck -&gt; Setup and click the 'Load' button. This will load the newly added device into VU Deck, allowing you to select it from the 'Select Device' drop-down list.</span></p>
        <p><img alt="windowssetup interface screenshot" src="data:image/png;base64,"></p>
      <a class="back" href="#top">Back to index ↑</a></section><section class="guide-page" id="troubleshooting" data-page="8" aria-labelledby="troubleshooting-label"><div class="page-label" id="troubleshooting-label">Section 8 of 9</div>
        <!-- Content -->
        <h2>Troubleshooting</h2>
        <p><span>Any time you make changes to your system's sound settings, you also need to update VU Deck's audio settings accordingly. Otherwise, your application may stop working.</span></p>
        <p><span>You can always return to the setup to make the necessary changes.</span></p>
        <p><span>To bring VU Deck and your system’s sound settings into alignment, follow the steps below:</span></p>
        <ol>
          <li><span>Find Active Output Audio Device: </span><span>At the bottom right corner of your Windows toolbar find speaker icon. When you hover over with your mouse you will see your system's default output audio device. You can also open your system’s sound settings and find out output device.</span></li>
        </ol><br>
        <ol>
            <li value="2"><span>Click on Setup on VU Deck's panel: </span><span>At the top of setup window make sure same device selected as the one as your system’s audio device.</span></li>
        </ol><br>
        <ol>
            <li value="3"><span>Select Device: </span><span>If the selected Audio Device not same as system’s active output device click on drop-down list. If you see your system’s device select it and click OK button.</span></li>
        </ol><br>
        <ol>
          <li value="4"><span>Load: </span><span>If you don't see your system’s audio device in drop-down list, click Load button than click on drop-down list again. If the device is loaded select it and click OK. In case of you don't see the your system’s device that means the device you are using not supported.</span></li>
        </ol><br>
      <a class="back" href="#top">Back to index ↑</a></section><section class="guide-page" id="feedback-and-support" data-page="9" aria-labelledby="feedback-and-support-label"><div class="page-label" id="feedback-and-support-label">Section 9 of 9</div>
        <!-- Content -->
        <h2>Feedback and Support</h2>
        <p><span>We would like to hear from you. If you need support or provide feedback, connect us via <a href="mailto:support@chattysparrow.com">  E-mail.</a></span></p>
        <a class="back" href="#top">Back to index ↑</a></section></main></div>
<Footer />

<script>
document.getElementById("email-link")?.addEventListener("click",(e)=>{
    e.preventDefault();

    const user="support";
    const domain="chattysparrow.com";

    window.location.href=`mailto:${user}@${domain}`;
});
</script>

</AppsLayout>