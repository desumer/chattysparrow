---
import AppsLayout from "@layouts/AppsLayout.astro";
import Header from "@components/vudeck/Header.astro";
import Footer from "@components/Footer.astro";
import { withBase } from "@utils/paths";
import mainViewScreenshot from "./lib/Screenshot_1.png";
import audioSourcesScreenshot from "./lib/Screenshot_2.png";
import generalSettingsScreenshot from "./lib/Screenshot_3.png";
---

<AppsLayout title="VU Deck - macOS User Guide" faviconPath={withBase("/favicons/vudeck")}>
<style>
.shell{--ink:#18324a;--blue:#087ff5;--teal:#19b7b0;--muted:#5f6b76;--paper:#fff;--line:#dbe3ea;--soft:#edf5fc;--warn:#fff4e5;--shadow:0 16px 42px rgba(25,48,69,.12)}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:1.5rem}body{margin:0;background:#eef2f5;color:#1f2933;font:16px/1.58 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}a{color:var(--blue)}
.shell{display:grid;grid-template-columns:290px minmax(0,920px);justify-content:center;gap:28px;padding:28px}.index{position:sticky;top:24px;align-self:start;background:var(--ink);color:#fff;border-radius:16px;padding:22px;max-height:calc(100vh - 48px);overflow:auto}.index h1{font-size:1.28rem;margin:0 0 4px}.index .platform{color:#76ded7;font-weight:750;font-size:.82rem;text-transform:uppercase;letter-spacing:.07em}.index p{color:#c9d6df;font-size:.88rem}.index nav{display:grid;gap:5px}.index a{display:grid;grid-template-columns:29px 1fr;gap:8px;align-items:start;color:#edf6ff;text-decoration:none;padding:9px;border-radius:9px;font-size:.87rem}.index a:hover,.index a:focus{background:#294d69}.index a span{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:var(--blue);font-weight:750}.index .email{display:block;margin-top:14px;color:#b9e7ff;font-size:.85rem}
.shell>main{display:grid;gap:28px}.guide-page{scroll-margin-top:24px;background:var(--paper);min-height:calc(100vh - 56px);padding:58px 64px;border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow);position:relative}.page-label{position:absolute;top:20px;right:28px;color:var(--muted);font-size:.76rem;font-weight:750;text-transform:uppercase;letter-spacing:.08em}.help-guide-cover{text-align:center;padding-top:5vh}.help-guide-cover .kicker{color:var(--teal);font-weight:800;text-transform:uppercase;letter-spacing:.07em}.help-guide-cover h1{font-size:3rem;line-height:1.06;color:var(--ink)}.lead{font-size:1.15rem;color:var(--muted);max-width:720px;margin:1.4rem auto}.topic-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:2rem}.topic-grid a{border:1px solid var(--line);border-radius:9px;padding:12px;text-decoration:none;color:var(--ink);display:grid}.topic-grid small{color:var(--muted)}
h2{font-size:1.65rem;color:var(--blue);margin:0 0 .8rem}h3{font-size:1.1rem;color:var(--ink);margin:1.5rem 0 .45rem}p{margin:.6em 0}ul{padding-left:1.45rem}.guide-page img{display:block;max-width:100%;height:auto;margin:1.4rem auto;border-radius:9px;box-shadow:0 10px 24px rgba(0,0,0,.14)}.callout{padding:14px 16px;border-radius:8px;background:var(--soft);border-left:4px solid var(--blue);margin:1.1rem 0}.callout.warning{background:var(--warn);border-color:#ff9500}.back{display:inline-block;margin-top:1.5rem;font-size:.82rem;color:var(--muted)}
@media(max-width:920px){.shell{display:block;padding:12px}.index{position:relative;top:auto;max-height:none;margin-bottom:16px}.index nav{grid-template-columns:1fr 1fr}.guide-page{min-height:0;padding:50px 28px}}@media(max-width:580px){.index nav,.topic-grid{grid-template-columns:1fr}.guide-page{padding:48px 18px}}@media print{body{background:#fff}.shell{display:block;padding:0}.index{display:none}.shell>main{display:block}.guide-page{box-shadow:none;border:0;min-height:auto;break-after:page;padding:.6in}.back{display:none}}
</style>

<Header />
<div class="shell" id="top">
  <aside class="index">
    <div class="platform">macOS help</div><h1>VU Deck</h1><p>Jump to any topic...</p>
    <nav aria-label="Section index">
      <a href="#overview"><span>1</span>Overview</a><a href="#get-started"><span>2</span>Getting Started</a>
      <a href="#sys-req"><span>3</span>System Requirements</a><a href="#installation"><span>4</span>Installation</a>
      <a href="#first-run"><span>5</span>First Run</a><a href="#general-settings"><span>6</span>General Settings</a>
      <a href="#audio-sources"><span>7</span>Audio Sources</a><a href="#troubleshooting"><span>8</span>Troubleshooting</a>
      <a href="#support"><span>9</span>Feedback and Support</a>
    </nav>
    <a class="email" href="#" data-email-link>Contact support</a>
  </aside>
  <main>
    <section class="guide-page help-guide-cover" id="overview"><div class="page-label">Section 1 of 9</div>
      <p class="kicker">Product help / macOS</p><h1>VU Deck</h1>
      <p class="lead">Monitor your Mac's audio with analog and LED VU meters. Capture selected apps and microphones through System Audio, or monitor an installed virtual audio device.</p>
      <nav class="topic-grid" aria-label="Guide topics">
        <a href="#get-started"><b>Getting Started</b><small>Meet the controls</small></a><a href="#sys-req"><b>System Requirements</b><small>Compatibility and permissions</small></a>
        <a href="#installation"><b>Installation</b><small>Install from the App Store</small></a><a href="#first-run"><b>First Run</b><small>Automatic System Audio setup</small></a>
        <a href="#general-settings"><b>General Settings</b><small>Customize the display</small></a><a href="#audio-sources"><b>Audio Sources</b><small>Choose apps, microphones, or virtual devices</small></a>
        <a href="#troubleshooting"><b>Troubleshooting</b><small>Resolve common audio issues</small></a><a href="#support"><b>Feedback and Support</b><small>Contact us</small></a>
      </nav>
    </section>

    <section class="guide-page" id="get-started"><div class="page-label">Section 2 of 9</div><h2>Getting Started</h2>
      <p>VU Deck displays the level of your selected Mac audio using analog meters, with an optional LED meter.</p>
      <img src={mainViewScreenshot.src} alt="VU Deck main window showing the Audio Source button" loading="lazy" />
      <ul><li><strong>Power</strong> starts and stops monitoring.</li><li><strong>Audio Source</strong> opens the source list.</li><li><strong>Shutdown</strong> closes VU Deck.</li></ul>
      <p>Move the window by dragging an empty area. Its minimum size keeps every control visible.</p><a class="back" href="#top">Back to index ↑</a>
    </section>

    <section class="guide-page" id="sys-req"><div class="page-label">Section 3 of 9</div><h2>System Requirements</h2>
      <ul><li>macOS 15.0 or later.</li><li>Intel or Apple silicon Mac.</li><li>At least 2 GB of memory recommended.</li><li>Permission to capture system audio.</li><li>Microphone permission when a hardware input is selected.</li></ul>
      <p>A third-party virtual audio device is optional. VU Deck's built-in System Audio source works without installing one.</p><a class="back" href="#top">Back to index ↑</a>
    </section>

    <section class="guide-page" id="installation"><div class="page-label">Section 4 of 9</div><h2>Installation</h2>
      <p>In the Mac App Store, click <strong>Get</strong>, then click again to install. When installation finishes, click <strong>Open</strong>.</p>
      <p>Later, launch VU Deck from Launchpad or the Applications folder in Finder.</p><a class="back" href="#top">Back to index ↑</a>
    </section>

    <section class="guide-page" id="first-run"><div class="page-label">Section 5 of 9</div><h2>First Run</h2>
      <p>On a fresh installation, VU Deck automatically creates its System Audio tap and aggregate device and selects <strong>System Audio</strong>. No audio-device setup window is required.</p>
      <p>Allow system-audio capture when macOS asks. If you select a microphone or another hardware input, also allow microphone access.</p>
      <div class="callout">Start audio in an app such as Music or a browser, open <strong>Audio Source</strong>, confirm the app is checked under Processes, then turn on <strong>Power</strong>.</div>
      <p>Installed virtual devices are available as alternatives, but are not selected automatically. Your selection is remembered between launches.</p><a class="back" href="#top">Back to index ↑</a>
    </section>

    <section class="guide-page" id="general-settings"><div class="page-label">Section 6 of 9</div><h2>General Settings</h2>
      <p>Open <strong>VU Deck → Settings…</strong> from the macOS menu bar. Settings displays the selected Audio Source and lets you customize the meter.</p>
      <img src={generalSettingsScreenshot.src} alt="General Settings window" loading="lazy" />
      <ul><li><strong>Audio Source</strong> is read-only here. Change it from the main-window button or <strong>VU Deck → Audio Sources…</strong>.</li><li><strong>Meter Style</strong> chooses Standard (RMS) or Peak response.</li><li><strong>Meter Adjustment</strong> adjusts Standard meter movement.</li><li><strong>VU Background, Needle Color, and Face Panel Color</strong> customize the display.</li><li><strong>LED VU Meter, Keep on Top, Hide Logo, and Mac Window</strong> control presentation.</li></ul>
      <p>Use <strong>Save &amp; Close</strong> to keep changes. Closing without saving discards them.</p><a class="back" href="#top">Back to index ↑</a>
    </section>

    <section class="guide-page" id="audio-sources"><div class="page-label">Section 7 of 9</div><h2>Audio Sources</h2>
      <p>Click <strong>Audio Source</strong> in the main window, or choose <strong>VU Deck → Audio Sources…</strong> from the menu bar.</p>
      <img src={audioSourcesScreenshot.src} alt="Audio Sources list with System Audio processes, a microphone, and a virtual audio device" loading="lazy" />
      <h3>System Audio</h3><p>System Audio combines selected app processes and optional hardware inputs. VU Deck updates the list automatically and filters background items that do not produce useful audio.</p>
      <ul><li>Check an app under <strong>Processes</strong> to include its audio; uncheck it to exclude it.</li><li>Check a microphone or other device under <strong>Hardware Inputs</strong> to mix it with app audio.</li><li>Apps must be running before they appear. A browser may be shown under an audio-processing helper process.</li></ul>
      <h3>Virtual Audio Devices</h3><p>Compatible installed loopback devices appear below System Audio. Select one to monitor audio routed through it, then click <strong>Done</strong>.</p>
      <p>If a selected virtual device disconnects or is removed, VU Deck automatically switches back to System Audio.</p><a class="back" href="#top">Back to index ↑</a>
    </section>

    <section class="guide-page" id="troubleshooting"><div class="page-label">Section 8 of 9</div><h2>Troubleshooting</h2>
      <h3>The meters do not move</h3><ul><li>Make sure Power is on and audio is playing.</li><li>Confirm the correct source is selected.</li><li>For System Audio, verify the playing app is checked under Processes.</li><li>Quit and reopen an app if it does not appear after it starts playing audio.</li></ul>
      <h3>A selected microphone cannot be heard</h3><p>Open <strong>System Settings → Privacy &amp; Security → Microphone</strong> and allow VU Deck. Check the microphone under Hardware Inputs, click Done, and restart VU Deck if permission was granted while it was running.</p>
      <h3>System Audio permission was denied</h3><p>Open <strong>System Settings → Privacy &amp; Security</strong>, enable VU Deck under the system-audio or screen-and-system-audio recording permission shown by your macOS version, then restart VU Deck.</p>
      <h3>A virtual audio device disappeared</h3><p>VU Deck automatically falls back to System Audio. Reconnect or reinstall the device and select it again if needed.</p>
      <div class="callout warning">If devices were reconfigured while VU Deck was open and the list does not refresh, quit and reopen VU Deck.</div><a class="back" href="#top">Back to index ↑</a>
    </section>

    <section class="guide-page" id="support"><div class="page-label">Section 9 of 9</div><h2>Feedback and Support</h2>
      <p>If you need support or want to provide feedback, contact us by <a href="#" data-email-link>email</a>.</p><a class="back" href="#top">Back to index ↑</a>
    </section>
  </main>
</div>
<Footer />
<script>
document.querySelectorAll("[data-email-link]").forEach((link) => {
  link.addEventListener("click", (event) => {
    event.preventDefault();
    window.location.href = "mailto:support@chattysparrow.com";
  });
});
</script>
</AppsLayout>
