---
import AppsLayout from "@layouts/AppsLayout.astro";
import Header from "@components/vudeck/Header.astro";
import Hero from "@components/vudeck/Hero.astro";
import Portfolio from "@components/vudeck/Portfolio.astro";
import Features from "@components/vudeck/Features.astro";
import Contact from "@components/Contact.astro";
import Footer from "@components/Footer.astro";
import { withBase } from '@utils/paths';
---

<AppsLayout title="VU Deck - Analog Vu Meter, LED Spectrum" faviconPath={withBase("/favicons/vudeck")}>

<Header />

<main>

    <Hero />

    <Portfolio />

    <Features />
    
    <Contact />

</main>

<Footer />

<script>
document.getElementById("email-link")?.addEventListener("click",(e)=>{
    e.preventDefault();

    const user="support";
    const domain="chattysparrow.com";

    window.location.href=`mailto:${user}@${domain}`;
});
</script>

</AppsLayout>