---
import AppsLayout from "@layouts/AppsLayout.astro";
import Header from "@components/vudeck/Header.astro";
import Footer from "@components/Footer.astro";
import { withBase } from '@utils/paths';
---

<AppsLayout title="VU Deck - macOS, Windows Help" faviconPath={withBase("/favicons/vudeck")} description="Help and support for VU Deck, a macOS and Windows application for audio visualization.">

<Header />

<main>

    <section id="about" class="about section">

      <!-- Section Title -->
      <div class="container section-title" data-aos="fade-up">
        <h2>Help</h2>
        <br>
        <div class="container">
          <p><a href={withBase("/vudeck/help/Mac/help")}><span>macOS</span></a></p>
          <br>
          <p><a href={withBase("/vudeck/help/Windows/help")}><span>Windows</span></a></p>
        </div>
      </div><!-- End Section Title -->

    </section>

</main>

<Footer />

</AppsLayout>