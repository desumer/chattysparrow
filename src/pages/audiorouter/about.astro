---
import AppsLayout from "@layouts/AppsLayout.astro";
import Header from "@components/audiorouter/Header.astro";
import Footer from "@components/Footer.astro";
import { withBase } from '@utils/paths';
---

<AppsLayout title="Chatty Sparrow - About" faviconPath={withBase("/favicons/audiorouter")}>

<Header />

<main>

    <section id="about" class="about section">

      <!-- Section Title -->
      <div class="container section-title" data-aos="fade-up">
        <h2>About</h2>
        <br>
        <div class="container">
          <p><a href={withBase("/audiorouter/company")}><span>Company</span></a></p>
          <br>
          <p><a href={withBase("/audiorouter/privacy")}><span>Privacy Policy</span></a></p>
          <br>
          <p><a href={withBase("/audiorouter/eula")}><span>End User License Agreement (EULA)</span></a></p>
        </div>
      </div><!-- End Section Title -->

    </section>

</main>

<Footer />

</AppsLayout>