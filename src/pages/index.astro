---
import MainLayout from "@layouts/MainLayout.astro";
import Header from "@components/Header.astro";
import Portfolio from "@components/Portfolio.astro";
import About from "@components/About.astro";
import Contact from "@components/Contact.astro";
import Footer from "@components/Footer.astro";
import { withBase } from '@utils/paths';
---

<MainLayout title="Chatty Sparrow - Audio Apps for macOS and Windows" description="Audio capture, routing, and visualization applications for macOS, Windows.">

<Header />

<main>

    <Portfolio />

    <section id="gethelp" class="services section">

      <!-- Section Title -->
      <div class="container section-title" data-aos="fade-up">
        <h2>Learn How to Use Our Apps</h2>
        <br>
          <div class="row text-center align-items-start g-4">

              <div class="col-md-4">
                  <img
                      src={withBase("/assets/apps/assets/img/vudeck/logo-fill.png")}
                      alt="VU Deck Logo"
                      class="img-fluid rounded-circle mb-3"
                      style="max-width: 90px;"
                  >

                  <p class="mb-1">
                      <a href={withBase("/vudeck/help/Mac/help")}>VU Deck (macOS)</a>
                  </p>
                  <p class="mb-0">
                      <a href={withBase("/vudeck/help/Windows/help")}>VU Deck (Windows)</a>
                  </p>
              </div>

              <div class="col-md-4">
                  <img
                      src={withBase("/assets/apps/assets/img/audiogate/logo-fill.png")}
                      alt="Audio Gate Logo"
                      class="img-fluid rounded-circle mb-3"
                      style="max-width: 100px;"
                  >

                  <p class="mb-0">
                      <a href={withBase("/audiogate/help")}>Audio Gate</a>
                  </p>
              </div>

              <div class="col-md-4">
                  <img
                      src={withBase("/assets/apps/assets/img/audiorouter/logo-Light.png")}
                      alt="Audio Router Logo"
                      class="img-fluid rounded-circle mb-3"
                      style="max-width: 100px;"
                  >

                  <p class="mb-0">
                      <a href={withBase("/audiorouter/help")}>Audio Router</a>
                  </p>
              </div>

          </div>      
      </div><!-- End Section Title -->

    </section>

    <Contact />

    <About />

</main>

<Footer />

<script>
document.getElementById("email-link")?.addEventListener("click",(e)=>{
    e.preventDefault();

    const user="support";
    const domain="chattysparrow.com";

    window.location.href=`mailto:${user}@${domain}`;
});
</script>

</MainLayout>