---
import { withBase } from '@utils/paths';
---

    <!-- Tutorials Section -->
    <section id="tutorials" class="services section light-background">

      <!-- Section Title -->
      <div class="container section-title" data-aos="fade-up">
        <h2>Tutorials</h2>
        <p>Learn how to use Audio Router with our tutorials.</p>
      </div><!-- End Section Title -->

      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row g-5">

          <div class="col-lg-6" data-aos="fade-right" data-aos-delay="200">
            <div class="service-item border border-light-subtle rounded-3 p-4 shadow-sm bg-white h-100">
              <div class="service-icon">
                <i class="bi bi-chat-left-text-fill me-1"></i>
              </div>
              <div class="service-content">
                <h3><a href={withBase("/audiorouter/tutorials/mix-mic-app-audio-discord")}>How to use Audio Router with Discord</a></h3>
                <p>Mix Microphone and App Audio in Discord on Mac.</p>
                <a href={withBase("/audiorouter/tutorials/mix-mic-app-audio-discord")} class="read-more">
                  <span>Learn</span>
                  <i class="bi bi-arrow-right"></i>
                </a>
              </div>
            </div>
          </div>

          <div class="col-lg-6" data-aos="fade-left" data-aos-delay="250">
            <div class="service-item border border-light-subtle rounded-3 p-4 shadow-sm bg-white h-100">
              <div class="service-icon">
                <i class="bi bi-camera-video-fill me-1"></i>
              </div>
              <div class="service-content">
                <h3><a href={withBase("/audiorouter/tutorials/logic-pro-audio-to-zoom")}>How to Send Processed Logic Pro Audio to Zoom on Mac</a></h3>
                <p>Learn how to Use Audio Router to send a microphone, software instrument, backing track, or complete Logic Pro mix into Zoom as a virtual microphone</p>
                <a href={withBase("/audiorouter/tutorials/logic-pro-audio-to-zoom")} class="read-more">
                  <span>Learn</span>
                  <i class="bi bi-arrow-right"></i>
                </a>
              </div>
            </div>
          </div>

          <div class="col-lg-6" data-aos="fade-right" data-aos-delay="300">
            <div class="service-item border border-light-subtle rounded-3 p-4 shadow-sm bg-white h-100">
              <div class="service-icon">
                <i class="bi bi-sliders me-1"></i>
              </div>
              <div class="service-content">
                <h3><a href={withBase("/audiorouter/tutorials/record-zoom-guest-logic-pro-mix-minus")}>How to Record a Zoom Guest in Logic Pro Without Echo</a></h3>
                <p> Record host and guest audio on separate tracks using a practical mix-minus configuration.</p>
                <a href={withBase("/audiorouter/tutorials/record-zoom-guest-logic-pro-mix-minus")} class="read-more">
                  <span>Learn</span>
                  <i class="bi bi-arrow-right"></i>
                </a>
              </div>
            </div>
          </div>

        </div>

      </div>

    </section><!-- /Services Section -->
