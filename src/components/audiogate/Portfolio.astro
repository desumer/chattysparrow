---
import { withBase } from '@utils/paths';
---

    <!-- Portfolio Section -->
    <section id="portfolio" class="portfolio section light-background">

      <!-- Section Title -->
      <div class="container section-title" data-aos="fade-up">
        <div class="card border-0 shadow rounded-4 bg-dark text-white">
          <div class="card-body p-4 p-lg-5">
            <h2 class="fs-1 fw-bold text-white mb-3">Audio recording made easier on your Mac</h2>
            <p class="lead text-white-50 mb-4">
              Capture, record macOS audio in one visual workspace.
            </p>

            <ul class="mb-0 ps-4">
              <li class="mb-3">Capture system audio, microphones, input devices, and app-based sources.</li>
              <li class="mb-3">Add sources as visual nodes that automatically route into the main mix.</li>
              <li class="mb-3">Review, play, reveal, refresh, or delete recordings from the sidebar.</li>
              <li class="mb-3">Choose CAF, WAV, AIFF, M4A, Float32, Int16, ALAC, or AAC.</li>
              <li class="mb-3">Start, pause, resume, and monitor recording time from the toolbar.</li>
              <li>Adjust gain, mute sources, and control the main mix before recording.</li>
            </ul>
          </div>
        </div>
      </div><!-- End Section Title -->

      <div class="container">

        <div class="isotope-layout" data-default-filter="*" data-layout="masonry" data-sort="original-order">

          <div class="row gy-4 isotope-container" data-aos="fade-up" data-aos-delay="200">
            <div class="col-lg-4 col-md-6 portfolio-item isotope-item filter-app">
              <div class="portfolio-content h-100">
                <img src={withBase("/src/assets/apps/assets/img/audiogate/portfolio/pic-1.jpg")} class="img-fluid" alt="">
                <div class="portfolio-info">
                  <a href={withBase("/src/assets/apps/assets/img/audiogate/portfolio/pic-1.jpg")} title="" data-gallery="portfolio-gallery-app" class="glightbox preview-link"><i class="bi bi-zoom-in"></i></a>
                </div>
              </div>
            </div><!-- End Portfolio Item -->

            <div class="col-lg-4 col-md-6 portfolio-item isotope-item filter-app">
              <div class="portfolio-content h-100">
                <img src={withBase("/src/assets/apps/assets/img/audiogate/portfolio/pic-2.jpg")} class="img-fluid" alt="">
                <div class="portfolio-info">
                  <a href={withBase("/src/assets/apps/assets/img/audiogate/portfolio/pic-2.jpg")} title="" data-gallery="portfolio-gallery-app" class="glightbox preview-link"><i class="bi bi-zoom-in"></i></a>
                </div>
              </div>
            </div><!-- End Portfolio Item -->

            <div class="col-lg-4 col-md-6 portfolio-item isotope-item filter-app">
              <div class="portfolio-content h-100">
                <img src={withBase("/src/assets/apps/assets/img/audiogate/portfolio/pic-3.jpg")} class="img-fluid" alt="">
                <div class="portfolio-info">
                  <a href={withBase("/src/assets/apps/assets/img/audiogate/portfolio/pic-3.jpg")} title="" data-gallery="portfolio-gallery-app" class="glightbox preview-link"><i class="bi bi-zoom-in"></i></a>
                </div>
              </div>
            </div><!-- End Portfolio Item -->

          </div><!-- End Portfolio Container -->

        </div>

      </div>

    </section><!-- /Portfolio Section -->
