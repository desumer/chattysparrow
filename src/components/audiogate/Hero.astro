---
import { withBase } from '@utils/paths';
---

    <!-- Hero Section -->
    <section id="hero" class="hero section dark-background">

      <img src={withBase("/assets/apps/assets/img/audiogate/hero-bg.jpg")} alt="" data-aos="fade-in" class="">

     <div class="container" data-aos="fade-up" data-aos-delay="100">
        <p class="fs-1">Audio Gate</p>
        <p>Record <span class="typed" data-typed-items=" web and app audio as well as mics audio..."></span><span class="typed-cursor typed-cursor--blink" aria-hidden="true"></span><span class="typed-cursor typed-cursor--blink" aria-hidden="true"></span></p><br/>
        <h1 class="fs-4">Mix audio from multiple sources</h1>
          <div class="justify-content-center mt-5">
          <div class="d-flex flex-column justify-content-center align-items text-center text-md-start" data-aos="fade-up">
            <p>Download for free
              <span class="d-block fs-6 fw-lighter mt-1 border-0">&lpar;When Audio Gate is used in Free Mode, some limitations apply.&rpar;</span>
            </p>
            <p class="mt-4">Available at...</p>
            <div class="d-flex mt-2 justify-content-center justify-content-md-start">
              <a href="#" class="download-btn"><i class="bi bi-apple"></i> <span>App Store</span></a>
            </div>
          </div>
        </div>
      </div>

    </section><!-- /Hero Section -->
