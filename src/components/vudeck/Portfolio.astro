---
import { withBase } from '@utils/paths';
---

    <section id="portfolio" class="portfolio section light-background">

      <!-- Section Title -->
      <div class="container section-title" data-aos="fade-up">
        <p class="fs-1">VuDeck developed as a standalone app for enjoying digital music on your computer. It is not intended to be a professional recording app.</p>
      </div><!-- End Section Title -->

      <div class="container">

        <div class="isotope-layout" data-default-filter="*" data-layout="masonry" data-sort="original-order">

          <!-- <ul class="portfolio-filters isotope-filters" data-aos="fade-up" data-aos-delay="100">
            <li data-filter=".filter-app">VuDeck</li> -->
          <!--/ul--><!-- End Portfolio Filters -->

          <div class="row gy-4 isotope-container" data-aos="fade-up" data-aos-delay="200">

            <div class="col-lg-4 col-md-6 portfolio-item isotope-item filter-app">
              <div class="portfolio-content h-100">
                <img src={withBase("/src/assets/apps/assets/img/vudeck/portfolio/pic-2.jpg")} class="img-fluid" alt="">
                <div class="portfolio-info">
                  <h4>Dark Panel, Analog Vu with Yellow Background, no Logo</h4>
                  <a href={withBase("/src/assets/apps/assets/img/vudeck/portfolio/pic-2.jpg")} title="Dark Panel, Analog Vu with yellow background, no Logo" data-gallery="portfolio-gallery-app" class="glightbox preview-link"><i class="bi bi-zoom-in"></i></a>
                </div>
              </div>
            </div><!-- End Portfolio Item -->

            <div class="col-lg-4 col-md-6 portfolio-item isotope-item filter-app">
              <div class="portfolio-content h-100">
                <img src={withBase("/src/assets/apps/assets/img/vudeck/portfolio/pic-8.jpg")} class="img-fluid" alt="">
                <div class="portfolio-info">
                  <h4>Light Panel, Analog Vu with blue background</h4>
                  <a href={withBase("/src/assets/apps/assets/img/vudeck/portfolio/pic-8.jpg")} title="Light Panel, Analog Vu with blue background" data-gallery="portfolio-gallery-app" class="glightbox preview-link"><i class="bi bi-zoom-in"></i></a>
                </div>
              </div>
            </div><!-- End Portfolio Item -->

            <div class="col-lg-4 col-md-6 portfolio-item isotope-item filter-app">
              <div class="portfolio-content h-100">
                <img src={withBase("/src/assets/apps/assets/img/vudeck/portfolio/pic-3.jpg")} class="img-fluid" alt="">
                <div class="portfolio-info">
                  <h4>Dark Panel, Classic Spectrum Display with LED Vu</h4>
                  <a href={withBase("/src/assets/apps/assets/img/vudeck/portfolio/pic-3.jpg")} title="Dark Panel, Classic Spectrum Display with LED Vu" data-gallery="portfolio-gallery-app" class="glightbox preview-link"><i class="bi bi-zoom-in"></i></a>
                </div>
              </div>
            </div><!-- End Portfolio Item -->

            <div class="col-lg-4 col-md-6 portfolio-item isotope-item filter-app">
              <div class="portfolio-content h-100">
                <img src={withBase("/src/assets/apps/assets/img/vudeck/portfolio/pic-5.jpg")} class="img-fluid" alt="">
                <div class="portfolio-info">
                  <h4>Light Panel, Rainbow Spectrum Display with LED Vu</h4>
                   <a href={withBase("/src/assets/apps/assets/img/vudeck/portfolio/pic-5.jpg")} title="Light Panel, Rainbow Spectrum Display with LED Vu" data-gallery="portfolio-gallery-app" class="glightbox preview-link"><i class="bi bi-zoom-in"></i></a>
                </div>
              </div>
            </div><!-- End Portfolio Item -->

            <div class="col-lg-4 col-md-6 portfolio-item isotope-item filter-app">
              <div class="portfolio-content h-100">
                <img src={withBase("/src/assets/apps/assets/img/vudeck/portfolio/pic-7.jpg")} class="img-fluid" alt="">
                <div class="portfolio-info">
                  <h4>Classic Windows style</h4>
                  <a href={withBase("/src/assets/apps/assets/img/vudeck/portfolio/pic-7.jpg")} title="Classic Windows style" data-gallery="portfolio-gallery-app" class="glightbox preview-link"><i class="bi bi-zoom-in"></i></a>
                </div>
              </div>
            </div><!-- End Portfolio Item -->

            <div class="col-lg-4 col-md-6 portfolio-item isotope-item filter-app">
              <div class="portfolio-content h-100">
                <img src={withBase("/src/assets/apps/assets/img/vudeck/portfolio/pic-6.jpg")} class="img-fluid" alt="">
                <div class="portfolio-info">
                  <h4>Setup window for easy layout customization</h4>
                  <a href={withBase("/src/assets/apps/assets/img/vudeck/portfolio/pic-6.jpg")} title="Setup window for easy layout customization" data-gallery="portfolio-gallery-app" class="glightbox preview-link"><i class="bi bi-zoom-in"></i></a>
                 </div>
              </div>
            </div><!-- End Portfolio Item -->


          </div><!-- End Portfolio Container -->

        </div>

      </div>

    </section><!-- /Portfolio Section -->
