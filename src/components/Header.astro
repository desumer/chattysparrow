---
import { withBase } from '@utils/paths';
---

  <header id="header" class="header dark-background d-flex flex-column">
    <i class="header-toggle d-xl-none bi bi-list"></i>

    <div class="header-top">
      <div class="profile-img">
        <img src={withBase("/assets/img/logo-graphic.png")} alt="Chatty Sparrow Logo" class="img-fluid rounded-circle">
      </div>

      <a href={withBase("/")} class="logo d-flex align-items-center justify-content-center">
        <span class="sitename">Chatty Sparrow</span>
      </a>
    </div>

    <nav id="navmenu" class="navmenu">
      <ul>
        <li><a href={withBase("/#portfolio")} class="active"><i class="bi bi-house navicon"></i>Home</a></li>
        <li class="dropdown"><a href={withBase("/apps")}><i class="bi bi-info-lg navicon"></i> <span>Apps</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
          <ul>
            <li><a href={withBase('/vudeck')}>VU Deck</a></li>
            <li><a href={withBase('/audiogate')}>Audio Gate</a></li>
            <li><a href={withBase('/audiorouter')}>Audio Router</a></li>
          </ul>
        </li>
        <li class="dropdown"><a href={withBase("/help")}><i class="bi bi-info-lg navicon"></i> <span>Help</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
          <ul>
            <li><a href={withBase('/vudeck/help')}>VU Deck</a></li>
            <li><a href={withBase('/audiogate/help')}>Audio Gate</a></li>
            <li><a href={withBase('/audiorouter/help')}>Audio Router</a></li>
          </ul>
        </li>
        <li><a href={withBase("/#contact")}><i class="bi bi-envelope navicon"></i> Contact</a></li>
        <li class="dropdown"><a href={withBase("/about")}><i class="bi bi-menu-button navicon"></i> <span>About</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
          <ul>
            <li><a href={withBase('/company')}>Company</a></li>
            <li><a href={withBase('/privacy')}>Privacy Policy</a></li>
            <li><a href={withBase('/eula')}><span>End User License <br>Agreement (EULA)</span></a></li>
          </ul>
        </li>
      </ul>
    </nav>

</header>